# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# Formspark endpoint for the contact form.
# Get one at https://formspark.io and paste the form action URL here.
# Without it the form still renders and validates, then reports that it is
# unconfigured rather than POSTing to `undefined`.
VITE_FORMSPARK_ACTION_URL=
